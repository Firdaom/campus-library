# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured in the Supabase dashboard (Authentication ->
# Providers -> Google), not here. These two are optional UX/enforcement
# knobs once the university domain is confirmed (spec: "Still to confirm").
# NEXT_PUBLIC_UNIVERSITY_EMAIL_DOMAIN only narrows Google's account picker;
# UNIVERSITY_EMAIL_DOMAIN is the real server-side check in
# app/auth/callback/route.ts. Leave both unset until confirmed.
NEXT_PUBLIC_UNIVERSITY_EMAIL_DOMAIN=
UNIVERSITY_EMAIL_DOMAIN=

# Shared secret the Supabase Cron (pg_cron + pg_net) jobs must send to
# /api/cron/expire-reservations and /api/cron/loan-notifications as
# `Authorization: Bearer <value>`. Store the real value in Supabase Vault,
# not here (see db/migrations/0001_pg_cron_jobs.sql).
CRON_SECRET=

# External services (mock endpoints are fine for local/dev)
STUDENT_IDENTITY_API_URL=
STUDENT_IDENTITY_API_KEY=
NOTIFICATION_HUB_URL=
NOTIFICATION_HUB_API_KEY=
ANALYTICS_URL=
ANALYTICS_API_KEY=
AI_RECOMMENDATION_URL=
AI_RECOMMENDATION_API_KEY=

# Loan policy
LOAN_PERIOD_DAYS=14
# Still to decide (spec section 6) — 5 is a placeholder.
MAX_ACTIVE_LOANS=5
